        currentUser = user;
        document.getElementById('loginBox').style.display = 'none';
        document.getElementById('sidebar').style.display = 'flex';
        document.body.classList.remove('login-active');
        updateAuditorSelects();
        renderAdmin();
        nav('auditor');
        updateOnlineUsers();
      } else alert('Λάθος στοιχεία ή ανενεργός');
    };

    window.nav = function(view) {
      ['auditorView','adminView'].forEach(v => document.getElementById(v).style.display = 'none');
      document.getElementById(view+'View').style.display = 'block';
      if (view==='admin') renderAdmin();
      if (view==='auditor') updateAuditorSelects();
    };
    window.logout = function() {
      currentUser = null;
      localStorage.removeItem(`online_${tabId}`);
      document.getElementById('sidebar').style.display = 'none';
      document.getElementById('loginBox').style.display = 'block';
      document.getElementById('auditorView').style.display = 'none';
      document.getElementById('adminView').style.display = 'none';
      document.body.classList.add('login-active');
      updateOnlineUsers();
    };
    window.toggleTheme = () => {}; // handled by select
    window.toggleChat = () => document.getElementById('chatPanel').classList.toggle('hidden');
    window.selectOption = function(option) {
      const chat = document.getElementById('chatMessages');
      chat.innerHTML += `<div class="message user-message">${option}</div>`;
      const scripts = {
        'ακριβό': 'Αντίρρηση "ακριβό": Τονίστε την εξοικονόμηση σε βάθος χρόνου και την ποιότητα εξυπηρέτησης.',
        'δέσμευση': 'Αντίρρηση "δέσμευση": Εξηγήστε την ευελιξία, π.χ. δοκιμή χωρίς δέσμευση.',
        'άλλος πάροχος': 'Αντίρρηση "άλλος πάροχος": Ζητήστε λεπτομέρειες και συγκρίνετε χαρακτηριστικά.',
        'δεν με ενδιαφέρει': 'Αντίρρηση "δεν με ενδιαφέρει": Προσπαθήστε να κερδίσετε το ενδιαφέρον με όφελος.',
        'θα το σκεφτώ': 'Αντίρρηση "θα το σκεφτώ": Κλείστε ραντεβού για επανάκληση.',
        'δύσκολη μεταφορά': 'Αντίρρηση "δύσκολη μεταφορά": Εμείς αναλαμβάνουμε τη γραφειοκρατία.'
      };
      setTimeout(() => {
        chat.innerHTML += `<div class="message bot-message">${scripts[option] || 'Δεν αναγνωρίζω'}</div>`;
        chat.scrollTop = chat.scrollHeight;
      }, 300);
    };

    loadDB();
  </script>
