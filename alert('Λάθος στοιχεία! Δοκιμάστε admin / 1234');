        <button class="option-btn" onclick="selectOption('δύσκολη μεταφορά')">Δύσκολη μεταφορά</button>
      </div>
    </div>
    <div class="bubble-button" onclick="toggleChat()"><i class="fas fa-comment-dots"></i></div>
  </div>

  <script>// ======================== ΒΑΣΗ ΔΕΔΟΜΕΝΩΝ ========================
let db = { companies: [], users: [] };
let currentUser = null;
let tabId = Date.now() + '-' + Math.random().toString(36).substr(2, 9);
let selectedCompPlanId = null;

// ΤΟ BIN ID ΣΑΣ ΑΠΟ ΤΟ JSONBIN
const BIN_ID = '69957a67ae596e708f33b8a4';

// Φόρτωση δεδομένων από JSONBin
async function loadDB() {
  try {
    const res = await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}/latest`);
    const data = await res.json();
    db = data.record;
    console.log('Φορτώθηκαν κοινά δεδομένα από JSONBin');
  } catch (error) {
    console.log('Σφάλμα φόρτωσης, χρήση localStorage');
    const stored = localStorage.getItem('energypro_db');
    if (stored) {
      db = JSON.parse(stored);
    } else {
      // Default δεδομένα
      db = {
        companies: [
          { id: 'c1', name: 'EnergyPro', isOur: true, plans: [
            { id: 'p1', name: 'Οικιακό Standard', monthlyFixed: 6.5, pricePerKwh: 0.138, forTelesales: true, forWinback: false },
            { id: 'p2', name: 'Επαγγελματικό Plus', monthlyFixed: 12.0, pricePerKwh: 0.122, forTelesales: false, forWinback: true }
          ]},
          { id: 'c2', name: 'Ζέφυρος Ενεργειακή', isOur: false, plans: [
            { id: 'p4', name: 'BASIC Home', monthlyFixed: 7.0, pricePerKwh: 0.155 }
          ]}
        ],
        users: [
          { id: 'u1', username: 'admin', password: '1234', role: 'admin', active: true },
          { id: 'u2', username: 'maria', password: '1234', role: 'telesales', active: true }
        ]
      };
    }
  }
  saveDB();
}

// Αποθήκευση δεδομένων στο JSONBin
async function saveDB() {
  // Τοπική αποθήκευση
  localStorage.setItem('energypro_db', JSON.stringify(db));
  
  // Αποθήκευση στο cloud για όλους
  try {
    await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(db)
    });
    console.log('Αποθηκεύτηκαν κοινά δεδομένα στο JSONBin');
  } catch (e) {
    console.log('Προσωρινή αποθήκευση μόνο τοπικά');
  }
}

// Login function
window.doLogin = async function() {
  const username = document.getElementById('username').value;
  const password = document.getElementById('password').value;
  
  await loadDB();
  
  const user = db.users.find(u => u.username === username && u.password === password && u.active);
  
  if (user) {
    currentUser = user;
    document.getElementById('loginBox').style.display = 'none';
    document.getElementById('sidebar').style.display = 'flex';
    document.body.classList.remove('login-active');
    updateAuditorSelects();
    renderAdmin();
    nav('auditor');
    updateOnlineUsers();
  } else {
    alert('Λάθος στοιχεία! Δοκιμάστε admin / 1234');
  }
};

// Οι υπόλοιπες συναρτήσεις μένουν ΑΚΡΙΒΩΣ ΙΔΙΕΣ από εδώ και κάτω
// [ΕΔΩ ΒΑΖΕΤΕ ΟΛΕΣ ΤΙΣ ΑΛΛΕΣ ΣΥΝΑΡΤΗΣΕΙΣ ΠΟΥ ΥΠΗΡΧΑΝ]
// Π.χ. updateAuditorSelects, compareAllPlans, renderAdmin, κλπ.
    }
  } catch (error) {
    // Fallback σε admin/1234 αν δεν φορτώσει το JSONBin
    if (username === 'admin' && password === '1234') {
      currentUser = { username: 'admin', role: 'admin' };
      document.getElementById('loginBox').style.display = 'none';
      document.getElementById('sidebar').style.display = 'flex';
      document.body.classList.remove('login-active');
      updateAuditorSelects();
      renderAdmin();
      nav('auditor');
      updateOnlineUsers();
    } else {
      alert('Λάθος στοιχεία ή πρόβλημα σύνδεσης');
    }
  }
};
