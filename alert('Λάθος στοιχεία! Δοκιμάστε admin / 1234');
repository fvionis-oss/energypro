  <!-- MODAL για χρήστες -->
  <div id="userModal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="userModalTitle">Νέος χρήστης</h3>
        <button class="btn-icon" onclick="closeUserModal()"><i class="fas fa-times"></i></button>
      </div>
      <form id="userForm" onsubmit="event.preventDefault(); saveUser();">
        <input type="hidden" id="userId">
        <label>Όνομα χρήστη</label>
        <input type="text" id="userUsername" required>
        <label>Email</label>
        <input type="email" id="userEmail" required>
        <label>Ρόλος</label>
        <select id="userRole">
          <option value="admin">Admin</option>
          <option value="telesales">Telesales</option>
          <option value="winback">Winback</option>
        </select>
        <label>Κατάσταση</label>
        <select id="userActive">
          <option value="true">Ενεργός</option>
          <option value="false">Ανενεργός</option>
        </select>
        <label>Κωδικός πρόσβασης (μόνο για νέο ή αλλαγή)</label>
