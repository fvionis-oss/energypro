        <div style="display: flex; gap: 15px; margin-top: 25px;">
          <button type="submit" class="btn-primary">Αποθήκευση</button>
          <button type="button" class="btn-warning" onclick="closePlanModal()">Ακύρωση</button>
        </div>
      </form>
    </div>
  </div>

  <!-- AI BUBBLE -->
  <div class="ai-bubble">
    <div id="chatPanel" class="chat-panel hidden">
      <div class="chat-header"><i class="fas fa-comment-dots"></i> Objection Bot <button class="btn-icon" style="margin-left: auto;" onclick="toggleChat()"><i class="fas fa-times"></i></button></div>
      <div class="chat-messages" id="chatMessages"><div class="message bot-message">Γεια! Διάλεξε μια αντίρρηση:</div></div>
