      <div class="modal-header">
        <h3 id="planModalTitle">Πρόγραμμα</h3>
        <button class="btn-icon" onclick="closePlanModal()"><i class="fas fa-times"></i></button>
      </div>
      <form id="planForm" onsubmit="event.preventDefault(); savePlan();">
        <input type="hidden" id="planId">
        <label>Εταιρεία</label>
        <select id="planCompanySelect" required></select>
        <label>Όνομα προγράμματος</label>
        <input type="text" id="planName" required>
        <div class="flex-row">
          <div class="half"><label>Πάγιο μήνα (€)</label><input type="number" id="planMonthlyFixed" step="0.01" required></div>
          <div class="half"><label>Τιμή kWh (€)</label><input type="number" id="planPricePerKwh" step="0.001" required></div>
        </div>
        <h4>Όρια κατανάλωσης (προαιρετικά)</h4>
        <div class="flex-row">
          <div class="half"><label>Μηνιαίο όριο (kWh)</label><input type="number" id="planMonthlyLimit" step="1" min="0"></div>
          <div class="half"><label>Ετήσιο όριο (kWh)</label><input type="number" id="planYearlyLimit" step="1" min="0"></div>
        </div>
        <div class="flex-row">
          <div class="half"><label>Ανοχή υπέρβασης (%)</label><input type="number" id="planTolerancePercent" step="0.1" min="0"></div>
          <div class="half"><label>Τιμή υπέρβασης (€/kWh)</label><input type="number" id="planOverLimitPrice" step="0.001"></div>
        </div>
        <div class="flex-row"><div class="half"><label>Έκπτωση %</label><input type="number" id="planDiscountPercent" step="0.1"></div></div>
