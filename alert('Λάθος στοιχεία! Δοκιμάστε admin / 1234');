<!DOCTYPE html>
<html lang="el">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EnergyPro CRM · Πλήρης Εφαρμογή</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ========== RESET & BASE ========== */
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Inter', sans-serif;
      transition: background-color 0.25s, color 0.2s;
    }

    /* ========== ΘΕΜΑΤΑ (βελτιωμένα χρώματα) ========== */
    body.theme-dark {
      background: #0b1120;
      color: #e2e8f0;
    }
    body.theme-dark .card,
    body.theme-dark .sub-card,
    body.theme-dark .modal-card,
    body.theme-dark .chat-panel,
    body.theme-dark #sidebar {
      background: #1e293b;
      border-color: #4b5563;
    }
    body.theme-dark input, body.theme-dark select, body.theme-dark textarea {
      background: #0f172a;
      border-color: #4b5563;
      color: #f1f5f9;
    }
    body.theme-dark .btn-icon { background: #374151; }
    body.theme-dark .btn-icon:hover { background: #2563eb; }

    body.theme-light {
      background: #f8fafc;
      color: #0f172a;
    }
    body.theme-light .card,
    body.theme-light .sub-card,
    body.theme-light .modal-card,
    body.theme-light .chat-panel,
    body.theme-light #sidebar {
      background: #ffffff;
      border-color: #cbd5e1;
    }
    body.theme-light input, body.theme-light select, body.theme-light textarea {
      background: #f1f5f9;
      border-color: #94a3b8;
      color: #0f172a;
    }
    body.theme-light .btn-icon { background: #e2e8f0; color: #1e293b; }
    body.theme-light .btn-icon:hover { background: #2563eb; color: white; }

    body.theme-blue {
      background: #0c4a6e;
      color: #e0f2fe;
    }
    body.theme-blue .card,
    body.theme-blue .sub-card,
    body.theme-blue .modal-card,
    body.theme-blue .chat-panel,
    body.theme-blue #sidebar {
      background: #075985;
      border-color: #38bdf8;
    }
    body.theme-blue input, body.theme-blue select, body.theme-blue textarea {
      background: #0c4a6e;
      border-color: #38bdf8;
      color: #e0f2fe;
    }
    body.theme-blue .btn-icon { background: #0c4a6e; }

    body.theme-green {
      background: #14532d;
      color: #dcfce7;
    }
    body.theme-green .card,
    body.theme-green .sub-card,
    body.theme-green .modal-card,
    body.theme-green .chat-panel,
    body.theme-green #sidebar {
      background: #166534;
      border-color: #4ade80;
    }
    body.theme-green input, body.theme-green select, body.theme-green textarea {
      background: #14532d;
      border-color: #4ade80;
      color: #dcfce7;
    }
    body.theme-green .btn-icon { background: #14532d; }

    body.theme-purple {
      background: #4a1d96;
      color: #f3e8ff;
    }
    body.theme-purple .card,
    body.theme-purple .sub-card,
    body.theme-purple .modal-card,
    body.theme-purple .chat-panel,
    body.theme-purple #sidebar {
      background: #5b21b6;
      border-color: #c084fc;
    }
    body.theme-purple input, body.theme-purple select, body.theme-purple textarea {
      background: #4a1d96;
      border-color: #c084fc;
      color: #f3e8ff;
    }
    body.theme-purple .btn-icon { background: #4a1d96; }

    body.theme-orange {
      background: #9a3412;
      color: #ffedd5;
    }
    body.theme-orange .card,
    body.theme-orange .sub-card,
    body.theme-orange .modal-card,
    body.theme-orange .chat-panel,
    body.theme-orange #sidebar {
      background: #b45309;
      border-color: #fb923c;
    }
    body.theme-orange input, body.theme-orange select, body.theme-orange textarea {
      background: #9a3412;
      border-color: #fb923c;
      color: #ffedd5;
    }
    body.theme-orange .btn-icon { background: #9a3412; }

    .badge { background: #2563eb; color: white; padding: 4px 12px; border-radius: 50px; font-size: 0.85rem; }
    .cheapest { background-color: #15803d !important; color: white; }
    .over-limit { background-color: #b91c1c !important; color: #fff; }
    body.theme-light .cheapest { background-color: #86efac !important; color: #0f172a; }
    body.theme-light .over-limit { background-color: #fecaca !important; color: #7f1d1d; }

    .msg-warning {
      background-color: #dc2626 !important;
      color: white !important;
      font-weight: 700 !important;
      padding: 12px 16px !important;
      border-radius: 10px !important;
      border-left: 6px solid #facc15 !important;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.5) !important;
      margin: 12px 0 !important;
      font-size: 1rem !important;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .msg-warning i { font-size: 1.5rem; color: #facc15; }

    /* ========== LOGIN BACKGROUND ========== */
    #loginBox {
      position: relative;
      z-index: 2;
      backdrop-filter: blur(10px);
      background: rgba(30, 41, 59, 0.85) !important;
      border: 2px solid rgba(255,255,255,0.2) !important;
      max-width: 420px;
      margin: 6% auto;
      border-radius: 40px;
      padding: 48px 40px;
      box-shadow: 0 30px 50px -20px black;
      color: #f1f5f9;
      text-align: center;
    }
    body.theme-light #loginBox {
      background: rgba(255,255,255,0.85) !important;
      color: #0f172a;
    }
    #loginBox h3 {
      font-size: 2.2rem;
      margin-bottom: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }
    #loginBox h3 i { color: #fbbf24; }
    #loginBox input {
      width: 100%;
      padding: 16px 20px;
      margin: 12px 0;
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(59, 78, 107, 0.8);
      border-radius: 30px;
      font-size: 1rem;
      color: #f1f5f9;
      outline: none;
    }
    body.theme-light #loginBox input {
      background: rgba(241, 245, 249, 0.7);
      border-color: rgba(148, 163, 184, 0.8);
      color: #0f172a;
    }
    #loginBox input:focus { border-color: #3b82f6; }
    #loginBox button {
      width: 100%;
      background: linear-gradient(145deg, #2563eb, #1e40af);
      border: none;
      padding: 18px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 1.2rem;
      color: white;
      margin-top: 25px;
      box-shadow: 0 12px 25px #1e3a8a;
      cursor: pointer;
      transition: transform 0.1s, box-shadow 0.1s;
    }
    #loginBox button:hover {
      transform: scale(1.02);
      box-shadow: 0 15px 30px #1e3a8a;
    }
    #loginBox p { margin-top: 20px; opacity: 0.6; font-size: 0.9rem; }

    /* Φόντο εικόνας μόνο όταν είναι ορατό το login */
    .login-active::before {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url('https://assets.cyclades24.gr/wp-content/uploads/2022/10/14233732/kaysima-revma-fysiko-aerio.jpg');
      background-size: cover;
      background-position: center;
      filter: blur(8px) brightness(0.6);
      z-index: -2;
    }
    .login-active::after {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-color: rgba(0, 0, 0, 0.3);
      z-index: -1;
    }
    body.theme-light.login-active::after {
      background-color: rgba(255, 255, 255, 0.2);
    }

    /* ========== ΔΟΜΗ ΕΦΑΡΜΟΓΗΣ ========== */
    #app { display: flex; height: 100vh; overflow: hidden; position: relative; z-index: 1; }

    #sidebar {
      width: 280px;
      backdrop-filter: blur(6px);
      display: flex;
      flex-direction: column;
      padding: 2rem 1rem 1.5rem;
      gap: 0.5rem;
      border-right: 1px solid;
      overflow-y: auto;
      background: rgba(15, 23, 42, 0.9) !important;
    }
    body.theme-light #sidebar {
      background: rgba(241, 245, 249, 0.9) !important;
    }
    #sidebar button {
      background: transparent;
      color: inherit;
      border: none;
      border-radius: 14px;
      padding: 15px 18px;
      font-size: 1rem;
      font-weight: 500;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: 0.2s;
      width: 100%;
    }
    #sidebar button i { width: 28px; font-size: 1.3rem; color: #38bdf8; }
    #sidebar button:hover {
      background: #2563eb;
      color: white;
      transform: translateX(5px);
    }
    #sidebar button:hover i { color: white; }

    #main {
      flex: 1;
      padding: 32px 40px;
      overflow-y: auto;
      background: transparent;
    }

    .card {
      border-radius: 28px;
      padding: 28px;
      margin: 24px 0;
      border: 1px solid;
      box-shadow: 0 20px 35px -15px #00000080;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 15px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0;
    }
    th, td {
      padding: 12px 8px;
      text-align: left;
      border-bottom: 1px solid;
    }
    .btn-icon {
      border: none;
      padding: 6px 12px;
      border-radius: 30px;
      margin: 0 4px;
      cursor: pointer;
      transition: 0.15s;
      font-size: 0.9rem;
    }
    .btn-primary {
      background: #10b981;
      border: none;
      color: white;
      padding: 12px 28px;
      border-radius: 36px;
      font-weight: 600;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: 0 8px 18px #0b5e42;
    }
    .btn-warning { background: #f59e0b; color: #0b1120; border: none; padding: 8px 18px; border-radius: 30px; font-weight: 600; }
    .btn-danger { background: #dc2626; color: white; border: none; padding: 8px 16px; border-radius: 30px; }

    input, select, textarea {
      border-radius: 20px;
      padding: 12px 18px;
      width: 100%;
      margin: 6px 0 14px;
      font-size: 0.95rem;
      border: 1px solid;
    }
    label { font-weight: 600; margin-top: 12px; display: block; }

    .flex-row { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-end; }
    .half { flex: 1 1 250px; }
    .sub-card {
      border-radius: 20px;
      padding: 18px;
      margin: 15px 0;
    }

    .comp-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 20px 0 10px;
    }
    .plan-tab {
      background: #1e2a3a;
      border: 2px solid #334155;
      border-radius: 40px;
      padding: 12px 20px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      flex: 1 0 auto;
      max-width: 220px;
      text-align: center;
      color: #ddd;
    }
    body.theme-light .plan-tab {
      background: #eef2f6;
      border-color: #b4c4d4;
      color: #1e293b;
    }
    .plan-tab.active {
      background: #2563eb;
      border-color: #60a5fa;
      color: white;
      transform: scale(1.02);
      box-shadow: 0 8px 18px #1e3a8a;
    }
    .plan-details-panel {
      background: #0f172a;
      border-radius: 24px;
      padding: 20px;
      margin: 10px 0 20px;
      border: 1px solid #2563eb;
    }
    body.theme-light .plan-details-panel {
      background: #ffffff;
      border-color: #2563eb;
    }
    .detail-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-top: 10px;
    }
    .detail-item {
      background: #1e293b;
      border-radius: 18px;
      padding: 14px;
      text-align: center;
    }
    body.theme-light .detail-item { background: #f1f5f9; }

    .comparison-table {
      width: 100%;
      margin-top: 20px;
    }
    .positive-benefit { color: #4ade80; font-weight: 600; }
    .negative-benefit { color: #f87171; font-weight: 600; }

    .modal-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }
    .modal-card {
      border-radius: 32px;
      padding: 32px;
      max-width: 800px;
      width: 90%;
      border: 1px solid #3b82f6;
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .ai-bubble {
      position: fixed;
      bottom: 30px;
      right: 30px;
      z-index: 2000;
    }
    .bubble-button {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: #2563eb;
      border: 3px solid #60a5fa;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s;
      color: white;
      font-size: 32px;
    }
    .bubble-button:hover {
      transform: scale(1.1);
      background: #3b82f6;
    }
    .chat-panel {
      position: absolute;
      bottom: 90px;
      right: 0;
      width: 360px;
      height: 550px;
      border-radius: 30px;
      border: 2px solid #3b82f6;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .chat-header {
      background: #2563eb;
      color: white;
      padding: 18px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .chat-messages {
      flex: 1;
      padding: 16px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .message {
      max-width: 80%;
      padding: 10px 14px;
      border-radius: 20px;
      font-size: 0.9rem;
    }
    .user-message {
      background: #2563eb;
      color: white;
      align-self: flex-end;
    }
    .bot-message {
      background: #2d3b52;
      color: #f1f5f9;
      align-self: flex-start;
    }
    body.theme-light .bot-message {
      background: #e9eef3;
      color: #0b1120;
    }
    .chat-options {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px;
      border-top: 1px solid #334155;
      background: #0f172a;
      justify-content: center;
    }
    .option-btn {
      background: #2563eb;
      border: none;
      border-radius: 30px;
      padding: 8px 12px;
      color: white;
      font-size: 0.8rem;
      cursor: pointer;
      flex: 1 0 auto;
      max-width: 100px;
      white-space: nowrap;
    }
    .hidden { display: none; }

    .comp-cost-breakdown {
      background: #0f172a;
      border-radius: 18px;
      padding: 16px;
      margin: 16px 0;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      border: 1px solid #3b82f6;
    }
    .breakdown-item { flex: 1; min-width: 150px; }
    .annual-excess { color: #fbbf24; font-weight: 600; }

    .online-users {
      margin-top: 10px;
      padding: 10px;
      background: #1e293b;
      border-radius: 10px;
    }
    .online-users ul {
      list-style: none;
      padding-left: 0;
      margin-top: 5px;
    }
    .online-users li i {
      margin-right: 8px;
      width: 20px;
      text-align: center;
    }
  </style>
</head>
<body class="theme-dark login-active">
  <div id="app">
    <!-- SIDEBAR (αρχικά κρυμμένο) -->
    <div id="sidebar" style="display: none;">
      <button onclick="nav('auditor')"><i class="fas fa-chart-line"></i> <span>Auditor</span></button>
      <button onclick="nav('admin')"><i class="fas fa-cog"></i> <span>Admin</span></button>
      <button onclick="logout()"><i class="fas fa-sign-out-alt"></i> <span>Έξοδος</span></button>
      <!-- Επιλογή θέματος -->
      <div style="margin: 10px 0; padding: 10px;">
        <label for="themeSelect" style="color: inherit;">Θέμα:</label>
        <select id="themeSelect" onchange="setTheme(this.value)" style="width:100%; padding:8px; border-radius:8px;">
          <option value="theme-dark">Σκούρο</option>
          <option value="theme-light">Ανοιχτό</option>
          <option value="theme-blue">Μπλε</option>
          <option value="theme-green">Πράσινο</option>
          <option value="theme-purple">Μοβ</option>
          <option value="theme-orange">Πορτοκαλί</option>
        </select>
      </div>
      <!-- Online users -->
      <div class="online-users">
        <i class="fas fa-users"></i> <span id="onlineCount">0</span> χρήστες online
        <ul id="onlineUsersList"></ul>
      </div>
    </div>

    <!-- MAIN -->
    <div id="main">
      <!-- LOGIN (αρχικά ορατή) -->
      <div id="loginBox">
        <h3><i class="fas fa-bolt"></i> EnergyPro</h3>
        <input type="text" id="username">
        <input type="password" id="password">
        <button onclick="doLogin()"><i class="fas fa-arrow-right-to-bracket"></i> Σύνδεση</button>
        <p><i class="fas fa-lock">
      </div>

      <!-- AUDITOR VIEW (κρυφή αρχικά) -->
      <div id="auditorView" style="display: none;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 30px;">
          <i class="fas fa-calculator" style="font-size: 2.8rem; color: #3b82f6;"></i>
          <h2 style="font-weight: 650; font-size: 2rem;">Αναλυτική Σύγκριση Προγραμμάτων</h2>
        </div>

        <div class="card">
          <div class="flex-row">
            <div class="half">
              <label><i class="fas fa-building"></i> Ανταγωνιστής</label>
              <select id="auditCompCo" onchange="updateCompTabs(); compareAllPlans()"></select>
            </div>
            <div class="half">
              <label><i class="fas fa-chart-simple"></i> Μηνιαία κατανάλωση (kWh)</label>
              <input type="number" id="auditKwh" value="50" step="50" min="0" oninput="compareAllPlans()">
            </div>
            <div class="half">
              <button class="btn-primary" onclick="compareAllPlans()" style="margin-top: 24px;"><i class="fas fa-rotate"></i> Υπολογισμός</button>
            </div>
          </div>

          <div id="compTabsContainer" style="margin-top: 20px;">
            <label><i class="fas fa-file-contract"></i> Επιλέξτε πρόγραμμα ανταγωνιστή:</label>
            <div id="compPlanTabs" class="comp-tabs"></div>
          </div>

          <div id="compPlanDetails" class="plan-details-panel" style="display: none;">
            <h4><i class="fas fa-info-circle"></i> Αναλυτικά χαρακτηριστικά προγράμματος</h4>
            <div id="compPlanDetailContent"></div>
          </div>
        </div>

        <div id="compCostBreakdown" class="comp-cost-breakdown"></div>

        <div class="card" id="comparisonResult">
          <h3>Σύγκριση προγραμμάτων EnergyPro με τον ανταγωνιστή</h3>
          <table class="comparison-table" id="allPlansTable">
            <thead>
              <tr>
                <th>Πρόγραμμα</th>
                <th>Πάγιο (€)</th>
                <th>Τιμή kWh (€)</th>
                <th>Κόστος κατανάλωσης (€)</th>
                <th>Σύνολο (€)</th>
                <th>Όφελος/μήνα (€)</th>
                <th>Όφελος/έτος (€)</th>
                <th>Ποσοστό</th>
                <th>Κατάσταση</th>
              </tr>
            </thead>
            <tbody id="allPlansBody"></tbody>
          </table>
          <p id="resultSuggestion" class="msg-success" style="font-size: 1.2rem; text-align: center; margin-top: 20px;"></p>
          <div id="limitWarnings" class="msg-warning" style="margin-top: 10px;"></div>
        </div>
      </div>

      <!-- ADMIN VIEW (κρυφή αρχικά) -->
      <div id="adminView" style="display: none;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 30px;">
          <i class="fas fa-user-shield" style="font-size: 2.8rem; color: #3b82f6;"></i>
          <h2 style="font-weight: 650; font-size: 2rem;">Πίνακας Διαχείρισης</h2>
        </div>

        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-building"></i> Εταιρείες & Τιμολόγια</h3>
            <button class="btn-primary" onclick="openAddCompanyModal()"><i class="fas fa-plus"></i> Νέα εταιρεία</button>
          </div>
          <div id="companyList"></div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-users"></i> Χρήστες CRM</h3>
            <button class="btn-primary" onclick="openUserModal()"><i class="fas fa-user-plus"></i> Νέος χρήστης</button>
          </div>
          <table>
            <thead><tr><th></th><th>Όνομα</th><th>Email</th><th>Ρόλος</th><th>Ενεργός</th><th>Ενέργειες</th></tr></thead>
            <tbody id="userTableBody"></tbody>
          </table>
        </div>

        <div class="card">
